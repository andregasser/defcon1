# No trailing slash: in a git worktree node_modules is often a symlink, which a
# directory-only pattern would not match.
node_modules
dist/
dist-demo/

# Your board and its rolling backups — local data, not source. Never commit these.
# No trailing slash for the same reason as above: once DEFCON1_DATA_DIR points
# outside the checkout, data is usually a symlink rather than a directory.
data
*.board.json
